<template>
	<div class="screen" :style="screenBgStyle">
		<div :style="containerStyle">

			<!-- 顶部状态栏 -->
			<div :style="headerBarStyle">
				<div class="headerLeft">
					<image :style="headerLogoStyle" mode="aspectFit" :src="logoSrc"></image>
				</div>
					<div class="headerCenter">
						<image :style="headerPhoneIconStyle" mode="aspectFit" src="/static/service.png"></image>
						<text :style="headerPhoneStyle">{{servicePhone}}</text>
						<div style="flex-direction: column; align-items: flex-start; margin-left: 5px;">
							<div style="border-width: 1px; border-color: rgba(255,255,255,0.6); border-radius: 3px; padding: 0 6px;;"><text :style="connTextStyle" v-if="maintainerText">设备维护:</text></div>
							<div style="flex-direction: row; align-items: center; border-width: 1px; border-color: rgba(255,255,255,0.6); border-radius: 3px; padding: 0 6px;">
								<text :style="connTextStyle" v-if="maintainerText">{{maintainerName}}</text>
								<text :style="connTextStyle" v-if="maintainerText">{{maintainerPhone}}</text>
							</div>
						</div>
					</div>
				<div class="headerRight">
				</div>
			</div>

			<!-- 时间日期区 (absolute) -->
				<text :style="dateStyle">{{currentDate}}</text>
				<div :style="weekTimeRowStyle">
					<text :style="weekStyle">{{currentWeek}}</text>
					<text :style="timeStyle">{{currentTime}}</text>
				</div>
			<text :style="sloganStyle">即时播报·拒绝漏单</text>
				<!-- middle图片区域 -->
				<image :style="middleImageStyle" mode="aspectFit" :src="showPaySuccess ? middleReverseSrc : middleSrc"></image>
				<text v-if="showPaySuccess" :style="paySuccessTextStyle">支付成功：{{paySuccessFee}}</text>

			<!-- 推广背景图 (absolute, 45%~100%H) -->
			<image :style="promoBgImageStyle" mode="aspectFill" :src="promoBgSrc"></image>

			<!-- 中国必诚 / 一起必诚 (absolute) -->
			<image :style="promoTitleImageStyle" mode="aspectFit" :src="promoTitleSrc"></image>
			<image :style="promoBottomImageStyle" mode="aspectFit" :src="promoBottomSrc"></image>


			<!-- 特色图标1: 收款便捷 -->
			<div :style="getFeatCircleStyle(0.05)">
				<image :style="getFeatIconStyle(0.049)" mode="aspectFit" :src="featIconSrc('wallet')"></image>
			</div>
			<text :style="getFeatLabelStyle(0.05)">收款便捷</text>
			<text :style="getFeatDescStyle(0.05, 0.88)">多种收款方式</text>
			<text :style="getFeatDescStyle(0.05, 0.90)">轻松支付更流畅</text>

			<!-- 特色图标2: 资金安全 -->
			<div :style="getFeatCircleStyle(0.15)">
				<image :style="getFeatIconStyle(0.149)" mode="aspectFit" :src="featIconSrc('secure')"></image>
			</div>
			<text :style="getFeatLabelStyle(0.15)">资金安全</text>
			<text :style="getFeatDescStyle(0.15, 0.88)">银行级风控保障</text>
			<text :style="getFeatDescStyle(0.15, 0.90)">资金安全可靠</text>

			<!-- 特色图标3: 经营清晰 -->
			<div :style="getFeatCircleStyle(0.25)">
				<image :style="getFeatIconStyle(0.249)" mode="aspectFit" :src="featIconSrc('report')"></image>
			</div>
			<text :style="getFeatLabelStyle(0.25)">经营清晰</text>
			<text :style="getFeatDescStyle(0.25, 0.88)">收款记录一目了然</text>
			<text :style="getFeatDescStyle(0.25, 0.90)">对账轻松更省心</text>

			<!-- 特色图标4: 贴心服务 -->
			<div :style="getFeatCircleStyle(0.35)">
				<image :style="getFeatIconStyle(0.349)" mode="aspectFit" :src="featIconSrc('support')"></image>
			</div>
			<text :style="getFeatLabelStyle(0.35)">贴心服务</text>
			<text :style="getFeatDescStyle(0.35, 0.88)">专属客服支持</text>
			<text :style="getFeatDescStyle(0.35, 0.90)">经营路上更安心</text>

			<!-- 右侧面板 (absolute) -->
			<div :style="rightColumnStyle">
					<div :style="orderHeaderStyle">
						<div style="flex-direction: row; align-items: center;">
							<image :style="orderHeaderIconStyle" mode="aspectFit" src="/static/icon/order.png"></image>
							<text :style="orderHeaderTextStyle">订单管理</text>
								<image :style="orderHeaderIconStyle" mode="aspectFit" :src="mqttStatusIcon"></image>
						</div>
						<div :style="deviceInfoStyle">
							<text :style="deviceInfoTextStyle">分辨率: {{screenWidth}}x{{screenHeight}}</text>
							<text :style="deviceInfoTextStyle">版本号: v{{version}}.{{versionCode}}</text>
							<text :style="deviceInfoTextStyle">设备号: {{deviceId}}</text>
						</div>
					</div>
				<list v-if="orderList.length" :style="orderListStyle">
					<cell v-for="(item, index) in orderList" :key="item.outTradeNo">
						<div :style="getOrderCardStyle(item.status)">
							<div class="orderCardLeft">
								<image :style="orderIconStyle" mode="aspectFit" :src="'/static/icon/'+item.method+'.png'"></image>
								<div :style="orderInfoStyle">
									<text :style="getOrderStatusTextStyle(item.status)">{{getStatusText(item.status, item.totalFee)}}</text>
									<text :style="orderTimeStyle">{{item.createdAt}}</text>
								</div>
							</div>
							<div class="orderCardRight">
								<text :style="getOrderFeeStyle(item.status)">{{fmtFee(item.totalFee)}}</text>
						</div>
							</div>
					</cell>
				</list>
				<div v-else :style="emptyStyle">
					<image :style="emptyIconStyle" mode="aspectFit" src="/static/icon/order.png"></image>
					<text :style="emptyTextStyle">暂无订单</text>
				</div>
			</div>

		</div>
	</div>
</template>

<script>
	import { baseTVUrl, themeName, themes } from '@/settings'
	import { formatFee as fmtFee, getStatusColor, getStatusText, getFeeColor } from '@/utils/order'
	import { getCurrentTime, getCurrentDate, getCurrentWeek, startClock } from '@/utils/datetime'
	const defaultTheme = 'orange'
	export default {
		data() {
			return {
				screenHeight: 720,
				screenWidth: 1280,
				deviceId: '',
				version: '',
				versionCode: '',
				currentTime: '',
				currentDate: '',
				currentWeek: '',
				clockTimer: null,
				showPaySuccess: false,
				paySuccessFee: '',
				paySuccessTimer: null,
			}
		},
		computed: {
			// ── 动态主题 ──
			activeTheme() {
				const config = this.$store.state.iot ? this.$store.state.iot.config : null
				const name = (config && config.TVTheme) || defaultTheme
				return themes[name] || themes[defaultTheme]
			},
			activeThemeName() {
				const config = this.$store.state.iot ? this.$store.state.iot.config : null
				return (config && config.TVTheme) || defaultTheme
			},
			// ── 主题图片路径 ──
			logoSrc() { return '/static/theme/logo-cyt.png' },
			middleSrc() { return '/static/theme/' + this.activeThemeName + '/middle.png' },
				middleReverseSrc() { return '/static/middle_reverse.png' },
			promoBgSrc() { return '/static/theme/' + this.activeThemeName + '/bottom/bottom_bg.png' },
			promoTitleSrc() { return '/static/theme/' + this.activeThemeName + '/zgbc.png' },
			promoBottomSrc() { return '/static/theme/' + this.activeThemeName + '/yqbc.png' },

			// ── 页面背景 ──
			screenBgStyle() { return `background-color: ${this.activeTheme.bgColor};` },

			// ── MQTT 状态 ──
			mqttConnected() {
				return this.$store.state.mqtt ? this.$store.state.mqtt.connected : false
			},
			mqttStatusIcon() {
				return '/static/icon/' + (this.mqttConnected ? 'MQTTactive.png' : 'MQTTclosed.png')
			},
			orderList() {
				return this.$store.state.mqtt ? this.$store.state.mqtt.orderList : []
			},
			lastOrder() {
				return this.$store.state.mqtt ? this.$store.state.mqtt.lastOrder : null
			},
			servicePhone() {
				const config = this.$store.state.iot ? this.$store.state.iot.config : null
				return (config && config.TVServicePhone) || '400-104-6788'
			},
						maintainerText() {
							const config = this.$store.state.iot ? this.$store.state.iot.config : null
				return (this.$store.state.iot && this.$store.state.iot.config && this.$store.state.iot.config.TVMaintainer) || ''
						},
						maintainerName() {
							const config = this.$store.state.iot ? this.$store.state.iot.config : null
							if (config && config.TVMaintainer) return config.TVMaintainer
							return ''
						},
						maintainerPhone() {
							const config = this.$store.state.iot ? this.$store.state.iot.config : null
							if (config && config.TVMaintainerPhone) return config.TVMaintainerPhone
							return ''
						},

			// ── 容器 ──
			containerStyle() {
				return `
					width: ${Math.round(this.screenHeight * 16 / 9)}px;
					height: ${this.screenHeight}px;
					background-color: ${this.activeTheme.bgColor};
				`
			},

			// ── 顶部状态栏 (absolute) ──
			headerBarStyle() {
				const h = this.screenHeight * 0.07
				return `
					position: absolute;
					top: ${this.screenHeight * 0.02}px;
					left: 0;
					width: ${Math.round(this.screenHeight * 16 / 9)}px;
					height: ${h}px;
					flex-direction: row;
					align-items: center;
					justify-content: flex-start;
					padding-left: ${this.screenHeight * 0.015}px;
					padding-right: ${this.screenHeight * 0.015}px;
				`
			},
			headerLogoStyle() {
				const h = this.screenHeight * 0.1
				const w = h * 3
				return `width: ${w}px; height: ${h}px;`
			},
			headerPhoneIconStyle() {
				const s = this.screenHeight * 0.038
				return `width: ${s}px; height: ${s}px; margin-right: ${this.screenHeight * 0.01}px;`
			},
			headerPhoneStyle() {
				const fs = this.screenHeight * 0.044
				return `font-size: ${fs}px; font-weight: 700; color: #ffffff; margin-right: ${this.screenHeight * 0.05}px;`
			},
			headerConnIconStyle() {
				const s = this.screenHeight * 0.015
				return `width: ${s}px; height: ${s}px; margin-right: ${this.screenHeight * 0.005}px;`
			},
			headerInfoStyle() {
				const fs = this.screenHeight * 0.013
				return `font-size: ${fs}px; color: rgba(255,255,255,0.95); margin-left: ${this.screenHeight * 0.01}px;`
			},
			headerSmallStyle() {
				const fs = this.screenHeight * 0.011
				return `font-size: ${fs}px; color: rgba(255,255,255,0.8); margin-left: ${this.screenHeight * 0.01}px;`
			},
			headerTinyStyle() {
				const fs = this.screenHeight * 0.01
				return `font-size: ${fs}px; color: rgba(255,255,255,0.7); margin-left: ${this.screenHeight * 0.01}px;`
			},

			// ── 时间日期区 (absolute) ──
			dateStyle() {
				const fs = this.screenHeight * 0.085
				return `position: absolute; top: ${this.screenHeight * 0.10}px; left: ${this.screenHeight * 0.01}px; font-size: ${fs}px; color: #ffffff;`
			},
			timeStyle() {
				const fs = this.screenHeight * 0.10
				return `font-size: ${fs}px; font-weight: 700; color: #ffffff;`
			},
			weekStyle() {
				const fs = this.screenHeight * 0.10
				return `font-size: ${fs}px; color: rgba(255,255,255,0.9); margin-right: ${this.screenHeight * 0.03}px;`
			},
			weekTimeRowStyle() {
			return `position: absolute; top: ${this.screenHeight * 0.21}px; left: ${this.screenHeight * 0.01}px; flex-direction: row; align-items: center; border-width: 1px; border-color: rgba(255,255,255,0.6); border-radius: 4px; padding: 2px 8px;`
			},

			sloganStyle() {
			const fs = this.screenHeight * 0.07
				return `position: absolute; top: ${this.screenHeight * 0.355}px; left: ${this.screenHeight * 0.01}px; font-size: ${fs}px; color: #ffffff; font-weight: 500; background-color: rgba(255, 255, 255, 0.5); border-radius: ${this.screenHeight * 0.02}px; padding: ${this.screenHeight * 0.005}px ${this.screenHeight * 0.015}px;`
			},
			middleImageStyle() {
					const h = this.screenHeight * 0.35
					const w = h * (240 / 265)
					return `position: absolute; top: ${this.screenHeight * 0.09}px; left: ${this.screenHeight * 0.605}px; width: ${w}px; height: ${h}px; border-radius: ${this.screenHeight * 0.012}px; overflow: hidden; box-shadow: 0 ${this.screenHeight * 0.005}px ${this.screenHeight * 0.015}px rgba(0,0,0,0.3);`
			},
			paySuccessTextStyle() {
				const fs = this.screenHeight * 0.03
				const h = this.screenHeight * 0.35
				return `position: absolute; top: ${this.screenHeight * 0.09 + h - fs - this.screenHeight * 0.02}px; left: ${this.screenHeight * 0.605}px; font-size: ${fs}px; font-weight: 700; color: #333333;`
			},

		// ── 推广背景图 (absolute, 45%~100%H) ──
			promoBgImageStyle() {
				const h = this.screenHeight * 0.53
				const w = h * (1185 / 685)
				const r = this.screenHeight * 0.012
				return `position: absolute; top: ${this.screenHeight * 0.45}px; left: ${this.screenHeight * 0.008}px; width: ${w}px; height: ${h}px; border-radius: ${r}px; overflow: hidden; box-shadow: 0 ${this.screenHeight * 0.005}px ${this.screenHeight * 0.015}px rgba(0,0,0,0.3);`
			},

			// ── 中国必诚 / 一起必诚 (absolute) ──
			promoTitleImageStyle() {
				const h = this.screenHeight * 0.2
				const w = h * 2.1
				return `position: absolute; top: ${this.screenHeight * 0.50}px; left: ${this.screenHeight * 0.03}px; width: ${w}px; height: ${h}px;`
			},
			promoBottomImageStyle() {
				const h = this.screenHeight * 0.17
				const w = h * 2.5
				return `position: absolute; top: ${this.screenHeight * 0.63}px; left: ${this.screenHeight * 0.03}px; width: ${w}px; height: ${h}px;`
			},

			// ── 右侧面板 (absolute) ──
				rightColumnStyle() {
					const w = this.screenHeight * 8 / 9
					const r = this.screenHeight * 0.015
					const p = this.screenHeight * 0.01
					return `position: absolute; top: ${this.screenHeight * 0.03}px; left: ${w + this.screenHeight * 0.06}px; width: ${w - this.screenHeight * 0.075}px; height: ${this.screenHeight * 0.95}px; flex-direction: column; background-color: ${this.activeTheme.panelBg}; border-radius: ${r}px; padding-top: ${p}px; padding-bottom: ${p}px; padding-left: ${this.screenHeight * 0.05}px; padding-right: ${this.screenHeight * 0.05}px;`
				},
				orderListStyle() {
					return `flex: 1;`
				},
					orderHeaderStyle() {
						const px = this.screenHeight * 0.01
						const py = this.screenHeight * 0.008
						return `flex-direction: row; align-items: center; justify-content: space-between; padding: ${py}px ${px}px; padding-bottom: ${this.screenHeight * 0.009}px; border-bottom-width: 1px; border-bottom-color: #ffffff; margin-bottom: ${py}px;`
					},
					orderHeaderIconStyle() {
						const s = this.screenHeight * 0.025
						return `width: ${s}px; height: ${s}px; margin-right: ${this.screenHeight * 0.008}px;`
					},
					orderHeaderTextStyle() {
						const fs = this.screenHeight * 0.036
						return `font-size: ${fs}px; font-weight: 700; color: #ffffff;`
					},
					connTextStyle() {
							const fs = this.screenHeight * 0.025
							return `font-size: ${fs}px; font-weight: 400; color: rgba(255,255,255,0.85);`
					},
					deviceInfoStyle() {
						return "flex-direction: column; align-items: flex-end; justify-content: center; flex-shrink: 0;"
					},
					deviceInfoTextStyle() {
						const fs = this.screenHeight * 0.014
						return `font-size: ${fs}px; font-weight: 400; color: rgba(255,255,255,0.8);`
					},


				// ── 订单图标 ──
				orderIconStyle() {
					const s = this.screenHeight * 0.05
					return `width: ${s}px; height: ${s}px;`
				},
				orderInfoStyle() {
					return `flex: 1; flex-direction: column; justify-content: center; margin-left: ${this.screenHeight * 0.01}px;`
				},
				orderTimeStyle() {
					const fs = this.screenHeight * 0.014
					return `font-size: ${fs}px; color: #909399;`
				},

				// ── 空状态 ──
				emptyStyle() {
					return `flex: 1; flex-direction: column; align-items: center; justify-content: center;`
				},
				emptyIconStyle() {
					const s = this.screenHeight * 0.04
					return `width: ${s}px; height: ${s}px; margin-bottom: ${this.screenHeight * 0.02}px; opacity: 0.3;`
				},
				emptyTextStyle() {
					const fs = this.screenHeight * 0.02
					return `font-size: ${fs}px; color: #999999;`
				},
		},
		onLoad() {
			this.$store.dispatch('tts/init')
			plus.navigator.setFullscreen(true)
			this.init()
			this.systemUpdate()
		},
		onUnload() {
			if (this.clockTimer) {
				clearInterval(this.clockTimer)
				this.clockTimer = null
			}
			this.$store.dispatch('mqtt/disconnect')
		},
		watch: {
			lastOrder(val) {
				if (val && val.status === 1 && val.totalFee > 0) {
					const fee = ((val.totalFee ? Number(val.totalFee) : 0) / 100).toFixed(2).replace(/.00/g, '')
					this.triggerPaySuccess(fee + '元')
				}
			}
		},

		methods: {
			triggerPaySuccess(fee) {
				if (this.paySuccessTimer) clearTimeout(this.paySuccessTimer)
				this.paySuccessFee = fee
				this.showPaySuccess = true
				this.paySuccessTimer = setTimeout(() => {
					this.showPaySuccess = false
				}, 3000)
			},
			// ── 初始化 ──
			init() {
				uni.getSystemInfo({
					success: (res) => {
						this.deviceId = res.deviceId
						const winW = Math.max(res.windowWidth, res.windowHeight)
						const winH = Math.min(res.windowWidth, res.windowHeight)
						this.screenHeight = winH

						this.clockTimer = startClock(() => {
							this.currentTime = getCurrentTime()
							this.currentWeek = getCurrentWeek()
							this.currentDate = getCurrentDate()
							this.currentWeek = getCurrentWeek()
						}, 1000)

						this.$store.dispatch('deviceProps/fetchProps').then(() => {
							return this.$store.dispatch('iot/fetchDeviceInfo')
						}).then(() => {
							const mqttInfo = this.$store.state.iot ? this.$store.state.iot.mqttInfo : null
							if (mqttInfo) {
								this.$store.dispatch('mqtt/connect', mqttInfo)
								this.$store.dispatch('mqtt/scheduleTokenRefresh')
							}
						}).catch((e) => {
							console.error('[index] MQTT初始化失败:', e)
						})
					}
				})
			},

				// ── 主题图标路径 ──
				featIconSrc(name) { return '/static/theme/' + this.activeThemeName + '/bottom/' + name + '.png' },

			// ── 特色图标方法 (absolute, 参数化 left) ──
			getFeatCircleStyle(leftPct) {
				const s = this.screenHeight * 0.07
				return `position: absolute; top: ${this.screenHeight * 0.78}px; left: ${this.screenHeight * leftPct}px; width: ${s}px; height: ${s}px; border-radius: ${s / 2}px; background-color: #ffffff; align-items: center; justify-content: center;`
			},
			getFeatIconStyle(leftPct) {
				const s = this.screenHeight * 0.065
				return `width: ${s}px; height: ${s}px;`
			},
			getFeatLabelStyle(leftPct) {
				const fs = this.screenHeight * 0.016
				return `position: absolute; top: ${this.screenHeight * 0.86}px; left: ${this.screenHeight * leftPct}px; font-size: ${fs}px; font-weight: 700; color: ${this.activeTheme.labelColor}; width: ${this.screenHeight * 0.07}px; text-align: center;`
			},
			getFeatDescStyle(leftPct, topPct) {
				const fs = this.screenHeight * 0.012
				return `position: absolute; top: ${this.screenHeight * topPct}px; left: ${this.screenHeight * leftPct}px; font-size: ${fs}px; color: ${this.activeTheme.descColor}; width: ${this.screenHeight * 0.07}px; text-align: center;`
			},

				getOrderCardStyle(status) {
					const px = this.screenHeight * 0.012
					const py = this.screenHeight * 0.014
					const r = this.screenHeight * 0.008
					const mb = this.screenHeight * 0.008
					return `flex-direction: row; align-items: center; justify-content: space-between; padding: ${py}px ${px}px; margin-bottom: ${mb}px; border-radius: ${r}px; background-color: #ffffff; border-left-width: 4px; border-left-color: ${getStatusColor(status)};`
				},
				getOrderStatusTextStyle(status) {
					const fs = this.screenHeight * 0.030
						return `font-size: ${fs}px; font-weight: 400; color: rgba(0,0,0,0.85); lines: 1; text-overflow: ellipsis;`
					},
				getOrderFeeStyle(status) {
					const fs = this.screenHeight * 0.046
					return `font-size: ${fs}px; font-weight: 900; color: ${getFeeColor(status)};`
				},

			// ── 工具方法 (复用 @/utils/order) ──
			fmtFee,
			getStatusText,

			// ── 系统更新 ──
			systemUpdate() {
				// #ifdef APP-PLUS
				plus.runtime.getProperty(plus.runtime.appid, (widgetInfo) => {
					this.versionCode = widgetInfo.versionCode
					this.version = widgetInfo.version
					uni.request({
						url: baseTVUrl + 'manifest.json',
						success: (result) => {
							let { versionCode, versionName } = JSON.parse(result.data.replace(/\/\*{1,2}[\s\S]*?\*\//g, ''))
							if (versionName === widgetInfo.version) {
								if (parseInt(widgetInfo.versionCode) != parseInt(versionCode)) {
									let downloadPath = baseTVUrl + plus.runtime.appid + '.wgt'
									uni.downloadFile({
										url: downloadPath,
										success: (downloadResult) => {
											if (downloadResult.statusCode === 200) {
												plus.runtime.install(downloadResult.tempFilePath, { force: true }, () => {
									console.log('热更新成功')
									plus.runtime.restart()
								}, (e) => {
									console.error('热更新失败:', e)
								})
											}
										},
										fail: (error) => { console.log('download fail', error) }
									})
								}
							}
						},
						fail: (error) => { console.log('systemUpdate', JSON.stringify(error)) }
					})
				})
				// #endif
			},
		},
	}
</script>

